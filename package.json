{
  "name": "www-genshin-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "原神启动 monorepo：应用与可独立发布的 xviewer 运行时",
  "scripts": {
    "dev": "pnpm run build:lib && pnpm --parallel -r run dev",
    "start": "pnpm --filter @xviewer2/www-genshin start",
    "build": "pnpm -r run build",
    "build:lib": "pnpm --filter @xviewer2/xviewer build",
    "build:app": "pnpm --filter @xviewer2/www-genshin build",
    "preview": "pnpm --filter @xviewer2/www-genshin preview",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm --filter @xviewer2/www-genshin lint",
    "publish:lib": "pnpm --filter @xviewer2/xviewer publish"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  }
}
